{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/auditoria-25-resolucion-integrada": false
    }
  },
  "ignoreCommand": "node scripts/ci/compuerta-deploy.mjs && exit 1 || exit 0",
  "crons": [
    {
      "path": "/api/cron/wa-pendientes",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/wa-outbox",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/runner",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/escalar",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/facturar",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/purgar",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/gps",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/asistencia",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/descarga-sat",
      "schedule": "25 */6 * * *"
    },
    {
      "path": "/api/cron/jornada",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/portales-vivos",
      "schedule": "40 6 * * 1"
    }
  ]
}
