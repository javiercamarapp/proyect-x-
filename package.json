{
  "name": "likida",
  "version": "0.1.0",
  "private": true,
  "description": "Agente de IA por WhatsApp que automatiza el cierre diario de operaciones logísticas en México.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src/",
    "lint:ratchet": "node scripts/ci/lint-ratchet.mjs",
    "audit:dev": "npm audit --include=dev --audit-level=moderate",
    "test:smoke": "node scripts/ci/playwright-smoke.mjs",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "node --max-old-space-size=6144 ./node_modules/typescript/bin/tsc --noEmit",
    "seed": "bash scripts/seed.sh",
    "setup": "npm install && npm run seed",
    "ticket": "vitest run arnes_ticket_real",
    "auditoria": "vitest run --config vitest.audit.config.ts scripts/auditoria/loop.audit.ts",
    "auditoria:baselina": "vitest run --config vitest.audit.config.ts scripts/auditoria/loop.audit.ts",
    "qa:nocturno": "vitest run --config vitest.qa.config.ts scripts/qa-agentes/orquestador.qa.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.71.0",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.115.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@upstash/qstash": "^2.11.3",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^5.11.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.40.0",
    "next": "^16.3.4",
    "openai": "^7.10.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "^4.0.0",
    "zxing-wasm": "^3.1.3"
  },
  "//overrides": "sharp procesa las fotos que llegan por WhatsApp — entrada NO autenticada. Next trae su propia copia anidada, así que subir la dependencia directa no basta: sin este override quedaba un sharp <0.35.0 vulnerable (CVE-2026-33327/33328/35590/35591 en libvips) en el árbol, alcanzable desde la primera foto de un chofer.",
  "overrides": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-security": "^4.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.11"
  }
}
